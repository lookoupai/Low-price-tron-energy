# TronScan API Keys 配置
# 申请地址：https://tronscan.org/#/developer/api
# 说明：
# 1. 至少需要配置一个 API Key (TRON_API_KEY_1)
# 2. 可以配置多个 API Key (TRON_API_KEY_2, TRON_API_KEY_3, ...)
# 3. 每个 Key 的限制：
#    - 每秒最多 5 次请求
#    - 每天最多 100,000 次请求
# 4. 系统会自动在多个 Key 之间轮询，提高请求上限

# 第一个 API Key（必需）
TRON_API_KEY_1=your_first_api_key_here

# 第二个 API Key（可选）
#TRON_API_KEY_2=your_second_api_key_here

# 第三个 API Key（可选）
#TRON_API_KEY_3=your_third_api_key_here

# 如需添加更多 API Key，按数字顺序增加即可
#TRON_API_KEY_4=your_fourth_api_key_here
#TRON_API_KEY_5=your_fifth_api_key_here

# 低价能量筛选区间（TRX）
# 市面已有 0.01 TRX 租能量，默认下限从 0.1 调整为 0.01
MIN_TRX_AMOUNT=0.01
MAX_TRX_AMOUNT=1

# Telegram Bot Token 配置
# 获取方式：与 @BotFather 对话创建机器人并获取 token
# 说明：
# 1. 在 Telegram 中搜索 @BotFather
# 2. 发送 /newbot 命令创建新机器人
# 3. 按提示设置机器人名称
# 4. 复制 BotFather 提供的 token 到这里
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 时区（消息时间和日志时间）
# Docker 镜像默认 Asia/Shanghai；本地 Python 运行时也建议设置
TZ=Asia/Shanghai

# 广告/公告配置
# 在消息底部显示的广告或公告内容
# 留空则不显示任何内容
# 内容里有 @ 时必须加引号，例如："查询机器人 @lowtronbot"
BOT_ADVERTISEMENT=

# PostgreSQL 配置
# 推荐继续使用远程数据库（如 Supabase），填写完整 DATABASE_URL
# 若要用本仓库自带 Postgres：docker compose --profile local-db up -d
POSTGRES_DB=tron_energy
POSTGRES_USER=tron
POSTGRES_PASSWORD=tron_energy_pass
DATABASE_URL=postgresql://username:password@host:port/database
